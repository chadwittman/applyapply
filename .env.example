# Runtime
NODE_ENV=production
PORT=5000
APP_ORIGIN=https://applyapply.xyz
# Comma-separated browser origins. Chrome-extension origins are handled by the API.
CORS_ORIGINS=https://applyapply.xyz
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Authentication and admin
APPLYAPPLY_JWT_SECRET=replace-with-a-long-random-secret
APPLYAPPLY_ADMIN_SECRET=replace-with-a-separate-long-random-secret

# AI and email
ANTHROPIC_API_KEY=sk-ant-...
# Or use OPENROUTER_API_KEY instead of ANTHROPIC_API_KEY.
HYPERBROWSER_API_KEY=hb_...
RESEND_API_KEY=re_...
TYPESAFE_API_KEY=ts_...
# Opt-in Jev review for sourcing listings; keep off until validated.
JAA_JEV=0
# Maximum Jev listing reviews per sourcing run (cost guardrail).
JAA_JEV_MAX_REVIEWS=30

# Billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# The text line. Sendblue sends and receives real iMessages; without these the
# /imessage test page still works, since it reads the same conversation engine.
SENDBLUE_API_BASE=https://api.sendblue.co/api
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
# The number Sendblue sends from, E.164, e.g. +15125550123.
SENDBLUE_FROM_NUMBER=
# Shared secret Sendblue signs inbound webhooks with, if you set one there.
SENDBLUE_WEBHOOK_SECRET=

# Never enable this outside local development.
ALLOW_LOCAL_BYPASS=false
