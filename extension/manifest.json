{
  "manifest_version": 3,
  "name": "applyapply",
  "version": "1.9.11",
  "description": "Auto-fill job applications with AI-generated apply kits",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "scripting",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://jobs.ashbyhq.com/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://instacart.careers/*",
    "https://applyapply-production.up.railway.app/*",
    "http://localhost:5000/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.ashbyhq.com/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://instacart.careers/*",
        "https://jobs.a16z.com/*",
        "https://stripe.com/jobs/*"
      ],
      "js": [
        "vendor/jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "voice.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "applyapply"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5000/*",
      "https://applyapply-production.up.railway.app/*"
    ]
  }
}
